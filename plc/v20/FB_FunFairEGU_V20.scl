FUNCTION_BLOCK "FB_FunFairEGU_V20"
VERSION : 1.0
   VAR_INPUT
      FirstScan : Bool;
      MotionPermit : Bool;
      DataValid : Bool;
      PauseDI : Bool;
      ResetButton : Bool;
      ClosePosition_um : DInt;
      OpenPosition_um : DInt;
      TargetPosition_um : DInt;
      Tolerance_um : DInt;
      Velocity_um_s : DInt;
      InputHW : HW_IO;
      OutputHW : HW_IO;
   END_VAR
   VAR_OUTPUT
      State : Int;
      ResultValid : Bool;
      Success : Bool;
      ActualPosition_um : DInt;
      SignedError_um : LReal;
      GripperFaultCode : Word;
      FaultCode : Word;
      LampDO0 : Bool;
      LampDO1 : Bool;
      LampDO2 : Bool;
   END_VAR
   VAR
      Game : "FB_StopGameV20";
      EGU : "FB_SFP_EGU_EGK_Profinet_Cyclic_DATA";
      LampTimer : TON_TIME;
      LampTick : Bool;
      LampStep : Int;
      PreviousLampMode : Int;
   END_VAR
   VAR_TEMP
      LampMode : Int;
   END_VAR
BEGIN
   #Game(FirstScan := #FirstScan,
         MotionPermit := #MotionPermit,
         DataValid := #DataValid,
         PauseDI := #PauseDI,
         ResetButton := #ResetButton,
         Ready := #EGU.b_00_READY_FOR_OPERATION,
         FieldbusControl := #EGU.b_01_CONTOL_AUTHORITY_FIELDBUS,
         DeviceError := #EGU.b_07_ERROR,
         NotFeasible := #EGU.b_03_NOT_FEASIBLE,
         CommandDone := #EGU.b_04_COMMAND_SUCCESSFULLY_PROCESSED,
         PositionReached := #EGU.b_13_POSITION_REACHED,
         ReceivedToggle := #EGU.b_05_COMMAND_RECEIVED_TOGGLE,
         ActualPosition_um := #EGU.di_ACTUAL_POSITION,
         ClosePosition_um := #ClosePosition_um,
         OpenPosition_um := #OpenPosition_um,
         TargetPosition_um := #TargetPosition_um,
         Tolerance_um := #Tolerance_um,
         Velocity_um_s := #Velocity_um_s);
   // Use one feedback sample for the displayed position, delta, score and diagnostics.
   #ActualPosition_um := #EGU.di_ACTUAL_POSITION;
   #GripperFaultCode := #EGU.i_DIAGNOSIS_ERROR;
   #EGU(b_RELEASE_FUNCTION_BLOCK := TRUE,
        b_00_FAST_STOP := TRUE,
        b_01_STOP := #Game.ControlledStop,
        b_02_ACKNOLEDGE := #Game.DeviceAck,
        b_03_PREPARE_FOR_SHUTDOWN := FALSE,
        b_04_SOFTRESET := FALSE,
        b_05_RELEASE_FOR_MANUAL_MOVEMENT := FALSE,
        b_06_REPEAT_COMMAND_TOGGLE := FALSE,
        b_07_GRIP_DIRECTION := FALSE,
        b_08_JOG_MODE_NEGATIVE := FALSE,
        b_09_JOG_MODE_POSITIVE := FALSE,
        b_11_RELEASE_WORKPIECE := FALSE,
        b_12_GRIP_WORKPIECE := FALSE,
        b_13_MOVE_TO_ABSOLUTE_POSITION := #Game.MoveAbsolute,
        b_14_MOVE_TO_RELATIVE_POSITION := FALSE,
        b_16_GRIP_WORKPIECE_AT_EXPECTED_POSITION := FALSE,
        b_30_BRAKE_TEST := FALSE,
        b_31_ACTIVATE_GRIP_FORCE_AND_POSITION_MAINTENANCE := FALSE,
        di_POSITION := #Game.PositionCommand_um,
        di_VELOCITY := #Game.VelocityCommand_um_s,
        di_GRIPPING_FORCE := 0,
        HW_ADDRESS_INPUT := #InputHW,
        HW_ADDRESS_OUTPUT := #OutputHW);
   #State := #Game.State;
   #ResultValid := #Game.ResultValid;
   #Success := #Game.Success;
   #SignedError_um := #Game.SignedError_um;
   #FaultCode := #Game.FaultCode;

   // A 250 ms half-period gives a nominal 2 Hz pause indication.
   #LampMode := 0;
   IF (#State = 30) OR (#State = 40) OR (#State = 50) THEN
      #LampMode := 1;
   ELSIF (#State = 80) AND #ResultValid THEN
      #LampMode := 2;
   END_IF;
   #LampTimer(IN := NOT #FirstScan AND (#LampMode <> 0)
      AND (#LampMode = #PreviousLampMode) AND NOT #LampTick, PT := T#250ms);
   #LampTick := #LampTimer.Q;
   IF #FirstScan OR (#LampMode <> #PreviousLampMode) THEN
      #LampStep := 0;
   ELSIF #LampTick THEN
      IF #LampMode = 1 THEN
         #LampStep := (#LampStep + 1) MOD 3;
      ELSE
         #LampStep := (#LampStep + 1) MOD 2;
      END_IF;
   END_IF;
   #PreviousLampMode := #LampMode;
   #LampDO0 := (#LampStep = 0) AND ((#LampMode = 1) OR ((#LampMode = 2) AND NOT #Success));
   #LampDO1 := (#LampMode = 1) AND (#LampStep = 1);
   #LampDO2 := ((#LampMode = 1) AND (#LampStep = 2))
      OR ((#LampMode = 2) AND (#LampStep = 0) AND #Success);
END_FUNCTION_BLOCK
