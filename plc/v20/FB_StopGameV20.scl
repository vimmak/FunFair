FUNCTION_BLOCK "FB_StopGameV20"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 1.0
   VAR_INPUT
      FirstScan : Bool; // TRUE on first OB1 scan after every startup
      MotionPermit : Bool; // Operational permissive, NOT a safety function
      DataValid : Bool; // Fresh/valid PN data; do not hard-wire TRUE
      PauseDI : Bool;
      ResetButton : Bool; // Momentary reset and manual device fault acknowledgement
      Ready : Bool;
      FieldbusControl : Bool;
      DeviceError : Bool;
      NotFeasible : Bool;
      CommandDone : Bool;
      PositionReached : Bool;
      ReceivedToggle : Bool;
      ActualPosition_um : DInt;
      ClosePosition_um : DInt;
      OpenPosition_um : DInt;
      TargetPosition_um : DInt;
      Tolerance_um : DInt; // Strict less-than; half width of success window
      Velocity_um_s : DInt;
   END_VAR
   VAR_OUTPUT
      MoveAbsolute : Bool;
      ControlledStop : Bool;
      DeviceAck : Bool;
      PositionCommand_um : DInt;
      VelocityCommand_um_s : DInt;
      SignedError_um : LReal;
      ResultValid : Bool;
      Success : Bool;
      State : Int;
      FaultCode : Word;
   END_VAR
   VAR
      GapTimer : TON_TIME;
      AckTimer : TON_TIME;
      StopTimer : TON_TIME;
      StableTimer : TON_TIME;
      StallTimer : TON_TIME;
      ResetTrigger : R_TRIG;
      ResetReleased : Bool;
      MoveIssuedThisRun : Bool;
      AckBaseline : Bool;
      TowardsOpen : Bool;
      PauseTarget_um : DInt;
      PauseWindow_um : DInt;
      StableAnchor_um : DInt;
      PreviousPosition_um : DInt;
   END_VAR
   VAR_TEMP
      Healthy : Bool;
      Stable : Bool;
   END_VAR
BEGIN
   IF #FirstScan THEN
      #State := 0;
      #FaultCode := W#16#0000;
      #DeviceAck := FALSE;
      #ResetReleased := FALSE;
      #MoveIssuedThisRun := FALSE;
      #ResultValid := FALSE;
      #Success := FALSE;
   END_IF;

   #ResetTrigger(CLK := #ResetButton);
   IF NOT #ResetButton THEN
      #ResetReleased := TRUE;
   END_IF;
   IF NOT #ResetButton OR NOT #DeviceError OR NOT #DataValid OR NOT #MotionPermit THEN
      #DeviceAck := FALSE;
   ELSIF #ResetTrigger.Q AND #ResetReleased AND NOT #FirstScan THEN
      #DeviceAck := TRUE;
      IF NOT #MoveIssuedThisRun THEN
         #State := 905;
      END_IF;
   END_IF;

   #Healthy := #DataValid AND #Ready AND #FieldbusControl
      AND NOT #DeviceError AND NOT #NotFeasible;
   #GapTimer(IN := (#State = 30) AND NOT #FirstScan, PT := T#50ms);
   #AckTimer(IN := ((#State = 40) OR (#State = 55)) AND NOT #FirstScan, PT := T#1s);
   #StopTimer(IN := (#State >= 55) AND (#State <= 70) AND NOT #FirstScan, PT := T#3s);
   #StallTimer(IN := (#State = 50) AND (#PreviousPosition_um = #ActualPosition_um), PT := T#15s);
   #PreviousPosition_um := #ActualPosition_um;
   #Stable := (#State = 70) AND #CommandDone AND #Healthy
      AND (ABS(DINT_TO_LREAL(#ActualPosition_um) - DINT_TO_LREAL(#StableAnchor_um)) <= 20);
   #StableTimer(IN := #Stable, PT := T#200ms);

   IF (#State = 0) AND (NOT #DataValid OR (NOT #DeviceError AND NOT #NotFeasible
      AND (NOT #Healthy OR NOT #MotionPermit))) THEN
      #State := 0;
   ELSIF NOT #MotionPermit THEN
      #FaultCode := W#16#0009;
      #State := 900;
   ELSIF (#State = 905) AND #DataValid AND NOT #Healthy THEN
      // Device ACK sent before first MOVE. Wait for valid ready feedback.
      #FaultCode := W#16#0001;
   ELSIF NOT #Healthy THEN
      #FaultCode := W#16#0001;
      #State := 900;
   ELSIF (#OpenPosition_um = #ClosePosition_um) OR (#Velocity_um_s <= 0) OR (#Tolerance_um <= 0) THEN
      #FaultCode := W#16#0002;
      #State := 900;
   ELSE
      IF #PauseDI AND ((#State = 30) OR (#State = 40) OR (#State = 50)) THEN
         #PauseTarget_um := #TargetPosition_um;
         #PauseWindow_um := #Tolerance_um;
         IF #State = 40 THEN
            #State := 55;
         ELSE
            #AckBaseline := #ReceivedToggle;
            #State := 60;
         END_IF;
      END_IF;
      CASE #State OF
         0:
            #TowardsOpen := #ActualPosition_um <> #OpenPosition_um;
            #State := 10;
         10: // Initial pause or fault recovery has no game score.
            IF NOT #PauseDI THEN
               #State := 30;
            END_IF;
         30:
            IF #GapTimer.Q THEN
               IF #TowardsOpen THEN
                  #PositionCommand_um := #OpenPosition_um;
               ELSE
                  #PositionCommand_um := #ClosePosition_um;
               END_IF;
               #VelocityCommand_um_s := #Velocity_um_s;
               #AckBaseline := #ReceivedToggle;
               #State := 40;
            END_IF;
         40:
            IF #ReceivedToggle <> #AckBaseline THEN
               #State := 50;
            ELSIF #AckTimer.Q THEN
               #FaultCode := W#16#0003;
               #State := 900;
            END_IF;
         50:
            IF #PositionReached AND #CommandDone
               AND (ABS(DINT_TO_LREAL(#ActualPosition_um) - DINT_TO_LREAL(#PositionCommand_um)) <= 100) THEN
               #TowardsOpen := NOT #TowardsOpen;
               #State := 30;
            ELSIF #StallTimer.Q THEN
               #FaultCode := W#16#0004;
               #State := 900;
            END_IF;
         55: // Consume any pending MOVE acknowledgement before issuing STOP.
            IF #ReceivedToggle <> #AckBaseline THEN
               #AckBaseline := #ReceivedToggle;
               #State := 60;
            ELSIF #AckTimer.Q THEN
               #FaultCode := W#16#0003;
               #State := 900;
            END_IF;
         60:
            IF #ReceivedToggle <> #AckBaseline THEN
               #StableAnchor_um := #ActualPosition_um;
               #State := 70;
            ELSIF #StopTimer.Q THEN
               #FaultCode := W#16#0005;
               #State := 900;
            END_IF;
         70:
            IF #StopTimer.Q THEN
               #FaultCode := W#16#0005;
               #State := 900;
            ELSIF #StableTimer.Q THEN
               #ResultValid := TRUE;
               #Success := ABS(DINT_TO_LREAL(#ActualPosition_um) - DINT_TO_LREAL(#PauseTarget_um))
                  < DINT_TO_LREAL(#PauseWindow_um);
               #State := 80;
            ELSIF NOT #Stable THEN
               #StableAnchor_um := #ActualPosition_um;
            END_IF;
         80:
            IF NOT #PauseDI THEN
               #ResultValid := FALSE;
               #Success := FALSE;
               #State := 30;
            END_IF;
         905:
            IF NOT #ResetButton THEN
               #FaultCode := W#16#0000;
               #TowardsOpen := #ActualPosition_um <> #OpenPosition_um;
               #State := 10;
            END_IF;
         900: // After a fault, recover deliberately by locking then releasing pause.
            IF #PauseDI THEN
               #FaultCode := W#16#0000;
               #TowardsOpen := #ActualPosition_um <> #OpenPosition_um;
               #State := 10;
            END_IF;
         ELSE
            #State := 900;
            #FaultCode := W#16#0008;
      END_CASE;
   END_IF;
   IF #State = 900 THEN
      #ResultValid := FALSE;
      #Success := FALSE;
   END_IF;
   #MoveAbsolute := (#State = 40) OR (#State = 50);
   IF #MoveAbsolute THEN
      #MoveIssuedThisRun := TRUE;
   END_IF;
   #ControlledStop := (#State = 10) OR (#State = 60) OR (#State = 70) OR (#State = 80)
      OR (((#State = 900) OR (#State = 905)) AND NOT #DeviceAck);
   IF (#State >= 55) AND (#State <= 80) THEN
      #SignedError_um := DINT_TO_LREAL(#ActualPosition_um) - DINT_TO_LREAL(#PauseTarget_um);
   ELSE
      #SignedError_um := DINT_TO_LREAL(#ActualPosition_um) - DINT_TO_LREAL(#TargetPosition_um);
   END_IF;
END_FUNCTION_BLOCK
