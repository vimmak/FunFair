FUNCTION_BLOCK "FB_FunFair_StopGame"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT
      Enable : Bool; // Operator enable; FALSE aborts, never auto-resumes
      Commissioned : Bool; // Set only after verified limits, units and stop test
      FirstScan : Bool; // TRUE on first OB1 scan after every startup
      MotionPermit : Bool; // Operational permissive, NOT a safety function
      DataValid : Bool; // Fresh/valid PN data; do not hard-wire TRUE
      GameButton : Bool; // Momentary button: press to start, release to stop
      ResetButton : Bool; // Separate momentary reset; does NOT ack gripper faults
      Ready : Bool;
      FieldbusControl : Bool;
      DeviceError : Bool;
      NotFeasible : Bool;
      CommandDone : Bool;
      PositionReached : Bool;
      ReceivedToggle : Bool;
      ActualPosition_um : DInt;
      LowPosition_um : DInt;
      HighPosition_um : DInt;
      TargetPosition_um : DInt;
      Tolerance_um : DInt; // Strict less-than; half width of success window
      Velocity_um_s : DInt;
      VerifiedMin_um : DInt; // From commissioned gripper parameters
      VerifiedMax_um : DInt;
      VerifiedMinVelocity_um_s : DInt;
      VerifiedMaxVelocity_um_s : DInt;
      PressFilter : Time := T#20ms;
      ReleaseFilter : Time := T#5ms;
      ResetFilter : Time := T#20ms;
      CommandGap : Time := T#50ms; // Must exceed validated PN output update time
      AckTimeout : Time := T#1s;
      MoveTimeout : Time := T#15s;
      StopTimeout : Time := T#3s;
      StableTime : Time := T#200ms; // Post-ack position stability window
      StableBand_um : DInt := 20; // Whole-window deviation from anchor
      EndpointBand_um : DInt := 100;
   END_VAR
   VAR_OUTPUT
      FastStopRelease : Bool; // Map to b_00_FAST_STOP: TRUE releases fast stop!
      MoveAbsolute : Bool;
      ControlledStop : Bool;
      PositionCommand_um : DInt;
      VelocityCommand_um_s : DInt;
      State : Int; // 0 disabled,10 wait release,20 armed,30 move gap,
                   // 40 move ack,50 moving,60 stop ack,70 settling,80 result,900 fault
      ResultValid : Bool;
      Success : Bool;
      FinalPosition_um : DInt;
      SignedError_um : DInt;
      RoundTarget_um : DInt;
      RoundTolerance_um : DInt;
      FaultCode : Word; // Application codes; see README
   END_VAR
   VAR
      PressTimer : TON_TIME;
      ReleaseTimer : TON_TIME;
      ResetTimer : TON_TIME;
      GapTimer : TON_TIME;
      AckTimer : TON_TIME;
      MoveTimer : TON_TIME;
      StopTimer : TON_TIME;
      StableTimer : TON_TIME;
      ButtonFiltered : Bool;
      ButtonPrevious : Bool;
      ResetPrevious : Bool;
      AckBaseline : Bool;
      StopAcked : Bool;
      StableAnchor_um : DInt;
      LowLatched_um : DInt;
      HighLatched_um : DInt;
      VelocityLatched_um_s : DInt;
      StableBandLatched_um : DInt;
      EndpointBandLatched_um : DInt;
      NeedRearm : Bool;
      PendingFault : Word;
      Initialized : Bool;
   END_VAR
   VAR_TEMP
      PressEdge : Bool;
      ReleaseEdge : Bool;
      ResetEdge : Bool;
      ConfigValid : Bool;
      Healthy : Bool;
      StableNow : Bool;
      ActiveRound : Bool;
      PositionDelta : LReal;
   END_VAR
BEGIN
   // All instance data must be NON-RETAIN. Call once, every OB1 scan.
   // FirstScan is required even if Initialized is already TRUE in memory.
   IF #FirstScan OR NOT #Initialized THEN
      #State := 0;
      #ButtonFiltered := #GameButton;
      #ButtonPrevious := #GameButton;
      #ResetPrevious := #ResetButton;
      #ResultValid := FALSE;
      #Success := FALSE;
      #FaultCode := W#16#0000;
      #PendingFault := W#16#0000;
      #NeedRearm := FALSE;
      #StopAcked := FALSE;
      #Initialized := TRUE;
   END_IF;

   #PressTimer(IN := #GameButton AND NOT #FirstScan, PT := #PressFilter);
   #ReleaseTimer(IN := NOT #GameButton AND NOT #FirstScan, PT := #ReleaseFilter);
   #ResetTimer(IN := #ResetButton AND NOT #FirstScan, PT := #ResetFilter);
   IF #PressTimer.Q THEN
      #ButtonFiltered := TRUE;
   ELSIF #ReleaseTimer.Q THEN
      #ButtonFiltered := FALSE;
   END_IF;
   #PressEdge := #ButtonFiltered AND NOT #ButtonPrevious;
   #ReleaseEdge := NOT #ButtonFiltered AND #ButtonPrevious;
   #ResetEdge := #ResetTimer.Q AND NOT #ResetPrevious;
   #ButtonPrevious := #ButtonFiltered;
   #ResetPrevious := #ResetTimer.Q;

   #ConfigValid := (#VerifiedMin_um >= 0)
      AND (#VerifiedMax_um <= 1000000)
      AND (#LowPosition_um >= #VerifiedMin_um)
      AND (#HighPosition_um <= #VerifiedMax_um)
      AND (#LowPosition_um < #HighPosition_um)
      AND (#TargetPosition_um >= #LowPosition_um)
      AND (#TargetPosition_um <= #HighPosition_um)
      AND (#Tolerance_um > 0) AND (#Tolerance_um <= 1000000)
      AND (#VerifiedMinVelocity_um_s > 0)
      AND (#Velocity_um_s >= #VerifiedMinVelocity_um_s)
      AND (#Velocity_um_s <= #VerifiedMaxVelocity_um_s)
      AND (#StableBand_um >= 0) AND (#StableBand_um <= 1000000)
      AND (#EndpointBand_um >= 0)
      AND (#EndpointBand_um < (#HighPosition_um - #LowPosition_um))
      AND (#PressFilter >= T#0ms) AND (#ReleaseFilter >= T#0ms)
      AND (#ResetFilter > T#0ms) AND (#CommandGap > T#0ms)
      AND (#AckTimeout > T#0ms) AND (#MoveTimeout > #AckTimeout)
      AND (#StableTime > T#0ms) AND (#StopTimeout > #StableTime);
   #Healthy := #DataValid AND #Ready AND #FieldbusControl
      AND NOT #DeviceError AND NOT #NotFeasible;
   #ActiveRound := (#State >= 30) AND (#State <= 70);

   // Timers are called in every scan, including reset/disable paths.
   #GapTimer(IN := (#State = 30) AND NOT #FirstScan, PT := #CommandGap);
   #AckTimer(IN := ((#State = 40) OR (#State = 60)) AND NOT #FirstScan,
             PT := #AckTimeout);
   #MoveTimer(IN := ((#State = 40) OR (#State = 50)) AND NOT #FirstScan,
              PT := #MoveTimeout);
   #StopTimer(IN := ((#State = 60) OR (#State = 70)) AND NOT #FirstScan,
              PT := #StopTimeout);

   // Anchor-based stability catches accumulated drift, unlike adjacent-scan delta.
   #PositionDelta := ABS(DINT_TO_LREAL(#ActualPosition_um)
                         - DINT_TO_LREAL(#StableAnchor_um));
   #StableNow := (#State = 70) AND #StopAcked AND #Healthy
      AND #CommandDone AND #PositionReached
      AND (#PositionDelta <= DINT_TO_LREAL(#StableBandLatched_um));
   #StableTimer(IN := #StableNow AND NOT #FirstScan, PT := #StableTime);

   IF NOT #Enable OR NOT #Commissioned OR NOT #MotionPermit THEN
      #State := 0;
      #ResultValid := FALSE;
      #Success := FALSE;
      #FaultCode := W#16#0000;
      #StopAcked := FALSE;
      #PendingFault := W#16#0000;
   ELSIF NOT #Healthy THEN
      #State := 900;
      #FaultCode := W#16#0001;
      #ResultValid := FALSE;
      #Success := FALSE;
   ELSIF (#ActualPosition_um < #VerifiedMin_um)
      OR (#ActualPosition_um > #VerifiedMax_um) THEN
      #State := 900;
      #FaultCode := W#16#0006;
      #ResultValid := FALSE;
      #Success := FALSE;
   ELSE
      // Operator reset while moving aborts via controlled stop, never declares a win.
      IF #ResetEdge AND #ActiveRound THEN
         #PendingFault := W#16#0007;
         #NeedRearm := TRUE;
         IF (#State <> 60) AND (#State <> 70) THEN
            #AckBaseline := #ReceivedToggle;
            #StopAcked := FALSE;
            #State := 60;
         END_IF;
      ELSIF #ReleaseEdge AND ((#State = 30) OR (#State = 40) OR (#State = 50)) THEN
         #AckBaseline := #ReceivedToggle;
         #StopAcked := FALSE;
         #State := 60;
      END_IF;

      CASE #State OF
         0:
            #State := 10;
         10: // Must observe actual and filtered button released before arming.
            IF NOT #GameButton AND NOT #ButtonFiltered THEN
               #State := 20;
            END_IF;
         20:
            IF #PressEdge THEN
               IF #ConfigValid THEN
                  #LowLatched_um := #LowPosition_um;
                  #HighLatched_um := #HighPosition_um;
                  #VelocityLatched_um_s := #Velocity_um_s;
                  #RoundTarget_um := #TargetPosition_um;
                  #RoundTolerance_um := #Tolerance_um;
                  #StableBandLatched_um := #StableBand_um;
                  #EndpointBandLatched_um := #EndpointBand_um;
                  #PositionCommand_um := #HighPosition_um;
                  #ResultValid := FALSE;
                  #Success := FALSE;
                  #FaultCode := W#16#0000;
                  #PendingFault := W#16#0000;
                  #NeedRearm := FALSE;
                  #State := 30;
               ELSE
                  #FaultCode := W#16#0002;
                  #State := 900;
               END_IF;
            END_IF;
         30: // All movement command bits low before each new absolute move.
            // Do not reverse while a raw release is still being filtered.
            IF #GameButton AND #GapTimer.Q THEN
               #AckBaseline := #ReceivedToggle;
               #State := 40;
            END_IF;
         40:
            IF #ReceivedToggle <> #AckBaseline THEN
               #State := 50;
            ELSIF #AckTimer.Q THEN
               #FaultCode := W#16#0003;
               #State := 900;
            END_IF;
         50:
            IF #MoveTimer.Q THEN
               #FaultCode := W#16#0004;
               #State := 900;
            ELSIF #CommandDone AND #PositionReached
               AND (ABS(DINT_TO_LREAL(#ActualPosition_um)
                  - DINT_TO_LREAL(#PositionCommand_um))
                    <= DINT_TO_LREAL(#EndpointBandLatched_um)) THEN
               IF #PositionCommand_um = #HighLatched_um THEN
                  #PositionCommand_um := #LowLatched_um;
               ELSE
                  #PositionCommand_um := #HighLatched_um;
               END_IF;
               #State := 30;
            END_IF;
         60:
            IF #ReceivedToggle <> #AckBaseline THEN
               #StopAcked := TRUE;
               #StableAnchor_um := #ActualPosition_um;
               #State := 70;
            ELSIF #AckTimer.Q THEN
               #FaultCode := W#16#0003;
               #State := 900;
            END_IF;
         70:
            IF #StopTimer.Q THEN
               #FaultCode := W#16#0005;
               #State := 900;
            ELSIF #StableTimer.Q THEN
               IF #NeedRearm THEN
                  #ResultValid := FALSE;
                  #Success := FALSE;
                  #FaultCode := #PendingFault;
               ELSE
                  #FinalPosition_um := #ActualPosition_um;
                  #SignedError_um := #FinalPosition_um - #RoundTarget_um;
                  #Success := ABS(DINT_TO_LREAL(#SignedError_um))
                     < DINT_TO_LREAL(#RoundTolerance_um);
                  #ResultValid := TRUE;
               END_IF;
               #State := 80;
            ELSIF NOT #StableNow THEN
               #StableAnchor_um := #ActualPosition_um;
            END_IF;
         80:
            IF #ResetEdge AND NOT #GameButton AND NOT #ButtonFiltered THEN
               #ResultValid := FALSE;
               #Success := FALSE;
               #FaultCode := W#16#0000;
               #State := 10;
            END_IF;
         900:
            #ResultValid := FALSE;
            #Success := FALSE;
            IF #ResetEdge AND NOT #GameButton AND NOT #ButtonFiltered
               AND #Healthy AND #ConfigValid THEN
               #FaultCode := W#16#0000;
               #State := 10;
            END_IF;
         ELSE
            #State := 900;
            #FaultCode := W#16#0008;
      END_CASE;
   END_IF;

   // Decode AFTER all transitions: stop wins over a move in the same scan.
   IF (#State = 0) OR (#State = 900) THEN
      #ResultValid := FALSE;
      #Success := FALSE;
   END_IF;
   #FastStopRelease := #Enable AND #Commissioned AND #MotionPermit
      AND (#State <> 0) AND (#State <> 900);
   #MoveAbsolute := #FastStopRelease AND ((#State = 40) OR (#State = 50));
   #ControlledStop := #FastStopRelease
      AND ((#State = 60) OR (#State = 70) OR (#State = 80));
   #VelocityCommand_um_s := #VelocityLatched_um_s;
END_FUNCTION_BLOCK
